<?xml version="1.0" encoding="utf-8"?>
<!-- Android refuses cleartext HTTP by default (API 28+). The self-test's HTTP checks talk to
     examples/http/server.py on loopback, reached through `adb reverse`, so cleartext is allowed there
     and nowhere else. An app keeps the default: HTTPS only. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
