<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The HTTP checks in the self-test (sttp's HttpURLConnectionBackend). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- The Device section asks for it: a runtime permission on Android 13+ that needs no hardware. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- The Location section: fine for the GPS provider, which the self-test moves with `adb emu geo fix`. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <application android:label="Thicket gallery" android:allowBackup="false"
                 android:networkSecurityConfig="@xml/network_security_config"
                 android:enableOnBackInvokedCallback="true">
        <!-- Thicket's file provider, which serves the files the gallery shares (thicket-share-android). -->
        <provider android:name="thicket.share.android.ThicketFileProvider"
                  android:authorities="${applicationId}.thicket.files"
                  android:exported="false" android:grantUriPermissions="true" />
        <!-- A share target, so the self-test is the app on the other end of a share. -->
        <activity android:name="example.gallery.android.ShareTargetActivity" android:exported="true"
                  android:label="Thicket gallery inbox">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
        <activity android:name="example.gallery.android.GalleryActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
