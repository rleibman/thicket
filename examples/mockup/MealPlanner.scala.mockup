// =============================================================================
//  MOCKUP — this does not compile and is not on the build path.
//
//  This is what an app should look like when Thicket is finished. It is a
//  mobile client for meal-o-rama, sharing its domain types with the ZIO/Caliban
//  server. Read it as a target to design towards, not a promise.
//
//  Roughly 15% of this exists today (docs/11 says exactly which).
// =============================================================================
package mealorama.client

import thicket.*
import thicket.zio.given
import zio.*

// The domain comes from the *same module the server uses*. No DTOs, no codegen,
// no drift: if the server changes `Recipe`, this stops compiling.
import mealorama.domain.{Ingredient, Recipe, RecipeId, Week, Meal}

// -----------------------------------------------------------------------------
// 1. Navigation is a value, not a string
// -----------------------------------------------------------------------------
// A route is an ADT, so you cannot navigate to a screen without its arguments;
// the back stack is `List[Route]`, which means state restoration is just
// serialising a list, and a test can assert on it directly.
// `derives Routable` generates deep-link parsing: mealorama://recipe/42.

enum Route derives Routable {
  case Plan(week: Week)
  case Recipe(id: RecipeId)
  case EditRecipe(id: Option[RecipeId])
  case Pantry
  case Settings
}

// -----------------------------------------------------------------------------
// 2. The app is a total function from Route to Screen
// -----------------------------------------------------------------------------
// Add a case to Route and this match fails to compile. There is no router
// registry to forget to update, and no runtime "unknown route" branch.

object MealPlanner extends ThicketApp[AppEnv] {

  val environment: ZLayer[Any, Nothing, AppEnv] = AppLayer.live
  val home: Route                               = Route.Plan(Week.current)

  def screen(route: Route): Screen = route match {
    case Route.Plan(week)     => PlanScreen(week)
    case Route.Recipe(id)     => RecipeScreen(id)
    case Route.EditRecipe(id) => EditRecipeScreen(id)
    case Route.Pantry         => PantryScreen()
    case Route.Settings       => SettingsScreen()
  }

  // Tabs are native: UITabBar, BottomNavigationView, a GtkStackSwitcher,
  // and an NSToolbar segmented control on macOS.
  override val tabs = Seq(
    Tab("Plan", Icon.Calendar, Route.Plan(Week.current)),
    Tab("Pantry", Icon.Basket, Route.Pantry),
    Tab("Settings", Icon.Gear, Route.Settings)
  )
}

// -----------------------------------------------------------------------------
// 3. Capabilities are declared, and the compiler enforces them
// -----------------------------------------------------------------------------
// This screen can navigate, read the plan and read recipes. It *cannot* make an
// arbitrary HTTP call or touch the pantry, because it did not ask for them.
// This is ZIO's R channel pushed down to the view layer.

def PlanScreen(week: Week)(using Nav, Planner, Recipes): Screen =
  Screen(
    title = week.starting.format(DateStyle.Medium),
    actions = Seq(
      Action.Add(onTap = Nav.push(Route.EditRecipe(None)))
    )
  ) {
    // A ZIO becomes a Signal of an explicit three-state value. The fiber is
    // forked into this screen's Scope, so leaving the screen interrupts it.
    val plan: Signal[Async[PlanError, Seq[Day]]] = Planner.forWeek(week).asSignal

    // 4. Async is an exhaustive match, so "forgot to handle loading" and
    //    "forgot to handle the error" are compile errors, not blank screens.
    Async(plan) {
      case Async.Loading =>
        Skeleton.list(rows = 7) // shimmer placeholders, platform-styled

      case Async.Failed(err) =>
        ErrorState(err.userMessage, retry = Planner.refresh(week))

      case Async.Done(days) =>
        // Virtualised: backed by UITableView / RecyclerView / GtkListView, so a
        // year of meals costs the same as a week.
        LazyColumn(days, key = _.date) { day =>
          Section(header = day.date.dayName) {
            ForEach(day.meals, key = _.id) { meal =>
              MealRow(meal)
            }
          }
        }
    }
  }

def MealRow(meal: Meal)(using Nav, Planner): Element =
  Row(gap = 12.dp, align = Align.Center)(
    Thumbnail(meal.recipe.image, size = 56.dp, corner = 8.dp),
    Column(gap = 2.dp)(
      Text(meal.recipe.name, style = Text.Body.emphasized),
      Text(s"${meal.servings} servings", style = Text.Caption.secondary)
    ),
    Spacer(),
    Disclosure()
  )
    .onTap(Nav.push(Route.Recipe(meal.recipe.id)))
    // Native swipe actions on iOS, a Material swipe-to-dismiss on Android,
    // and a right-click context menu on desktop. One declaration, three idioms.
    .swipeActions(
      SwipeAction.destructive("Remove")(Planner.remove(meal.id)),
      SwipeAction("Double")(Planner.scale(meal.id, 2))
    )

// -----------------------------------------------------------------------------
// 5. Platform fidelity by *refinement*, not by lowest common denominator
// -----------------------------------------------------------------------------
// The default is already native. `.platform` is for when you want to say
// something extra on one platform — and it is local, not a forked codebase.

def RecipeScreen(id: RecipeId)(using Nav, Recipes): Screen =
  Screen(title = "Recipe") {
    Async(Recipes.byId(id).asSignal) {
      case Async.Loading     => Skeleton.detail()
      case Async.Failed(e)   => ErrorState(e.userMessage, retry = Recipes.refresh(id))
      case Async.Done(recipe) =>
        Scroll {
          Column(gap = 16.dp, padding = 16.dp)(
            Hero(recipe.image, ratio = 16 / 9f),
            Text(recipe.name, style = Text.Title),
            IngredientList(recipe.ingredients),
            Markdown(recipe.method),

            Button("Add to this week", role = Button.Prominent)(
              Recipes.addToPlan(recipe.id, Week.current) *> Nav.pop
            ),

            Button("Delete", role = Button.Destructive)(Recipes.delete(recipe.id))
              .confirm("Delete this recipe?", confirmLabel = "Delete")
              .platform(
                desktop = _.shortcut(Key.Delete),      // menu accelerator
                ios     = _.hapticOnConfirm(Haptic.Warning)
              )
          )
        }
    }
  }

// -----------------------------------------------------------------------------
// 6. Forms: validation lives in the type, and the toolbar knows about it
// -----------------------------------------------------------------------------
// `RecipeDraft`'s refinements are the single source of truth. The Done button's
// `enabled` is derived from them — you cannot forget to disable it, and you
// cannot submit a draft that does not satisfy the server's own constraints,
// because this is the server's own type.

final case class RecipeDraft(
    name: String :| NonEmpty,
    servings: Int :| Between[1, 24],
    ingredients: List[Ingredient] :| NonEmpty,
    notes: String
) derives Form.Schema

def EditRecipeScreen(id: Option[RecipeId])(using Nav, Recipes): Screen =
  val form = Form.of[RecipeDraft](initial = id.map(Recipes.draft))

  Screen(
    title = if id.isDefined then "Edit recipe" else "New recipe",
    actions = Seq(
      Action.Cancel(Nav.pop),
      Action.Done(enabled = form.valid)(
        for
          draft <- form.value
          saved <- Recipes.save(draft)
          _     <- Nav.replace(Route.Recipe(saved.id))
        yield ()
      )
    )
  ) {
    // `Field(_.name)` is a lens: the compiler knows the field's type, so it
    // rejects a Stepper bound to a String, and the error text comes from the
    // refinement rather than from a hand-written validator.
    Form(form)(
      Field(_.name)(TextField(placeholder = "Name")),
      Field(_.servings)(Stepper(range = 1 to 24)),
      Field(_.ingredients)(IngredientEditor()),
      Field(_.notes)(TextArea(lines = 4))
    )
  }

// -----------------------------------------------------------------------------
// 7. Long-running work is owned by the component
// -----------------------------------------------------------------------------
// `launch` forks into the component's ZIO Scope. Navigate away and the fiber is
// interrupted and the socket closed — not by a cleanup callback you remembered
// to write, but because the scope closed.

def PantryScreen()(using Nav, Pantry): Screen =
  Screen(title = "Pantry") {
    val items = Pantry.items.asSignal // a ZStream, live-updating
    val query = Var("")

    Column(gap = 8.dp)(
      SearchField(query, placeholder = "Filter"),

      Async(items) {
        case Async.Loading   => Skeleton.list(rows = 10)
        case Async.Failed(e) => ErrorState(e.userMessage, retry = Pantry.resync)
        case Async.Done(all) =>
          val shown = (all, query.debounced(300.millis)).mapN { (xs, q) =>
            xs.filter(_.name.toLowerCase.contains(q.toLowerCase))
          }

          LazyColumn(shown, key = _.id) { item =>
            Row(gap = 12.dp)(
              Checkbox(item.inStock, onChange = Pantry.setStock(item.id, _)),
              Text(item.name),
              Spacer(),
              Text(item.quantity.show, style = Text.Caption.secondary)
            )
          }
      }
    ).launch(Pantry.subscribeToChanges) // interrupted on unmount
  }

// -----------------------------------------------------------------------------
// 8. Tests drive the real tree through a headless renderer
// -----------------------------------------------------------------------------
// No emulator, no simulator, no screenshots. The same reconciler, a renderer
// that records instead of drawing, and ZIO's TestClock so debounces are exact.

class PlanScreenSpec extends UiSpec {

  test("removing a meal takes it off the plan") {
    val app = TestApp(MealPlanner, environment = AppLayer.test)
    app.navigate(Route.Plan(Week.of(2026, 38)))

    app.node[Text]("Chicken tagine").swipe(Left).tap("Remove")

    assert(app.findAll[Text]("Chicken tagine").isEmpty)
    assertEquals(app.backStack, List(Route.Plan(Week.of(2026, 38))))
  }

  test("the save button stays disabled until the draft is valid") {
    val app = TestApp(MealPlanner, environment = AppLayer.test)
    app.navigate(Route.EditRecipe(None))

    assert(!app.action("Done").enabled)
    app.node[TextField]("Name").type("Tagine")
    app.node[IngredientEditor].add("Chicken", 500.g)
    assert(app.action("Done").enabled)
  }
}
